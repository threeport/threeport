# generated by 'threeport-sdk gen' but will not be regenerated - can optionally be edited
FROM golang:1.24-alpine as builder
ARG PULUMI_VERSION=3.185.0
WORKDIR /
# install pulumi using official install script
RUN apk update && apk add --no-cache ca-certificates curl
RUN curl -fsSL https://get.pulumi.com | sh -s -- --version ${PULUMI_VERSION}
# create state directory placeholder
RUN mkdir -p /threeport-state

FROM gcr.io/distroless/static:nonroot
COPY gcp-controller /gcp-controller
COPY --from=builder /root/.pulumi/bin/pulumi* /usr/local/bin/
# Copy state directory with proper ownership for nonroot user (65532:65532)
COPY --from=builder --chown=65532:65532 /threeport-state /.threeport
USER 65532:65532
ENV USER=nonroot
ENV HOME=/.threeport

ENTRYPOINT ["/gcp-controller"]
