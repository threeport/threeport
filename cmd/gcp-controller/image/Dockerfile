# generated by 'threeport-sdk gen' but will not be regenerated - can optionally be edited
FROM golang:1.24-alpine as builder
ARG ARCH=amd64
ARG PULUMI_VERSION=3.142.0
WORKDIR /
# download pulumi
RUN apk update && apk add --no-cache ca-certificates wget tar
RUN wget https://get.pulumi.com/releases/sdk/pulumi-v${PULUMI_VERSION}-linux-${ARCH}.tar.gz \
    && tar -xzf pulumi-v${PULUMI_VERSION}-linux-${ARCH}.tar.gz
# build controller
RUN mkdir /build
ADD . /build
WORKDIR /build
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${ARCH} go build -a -o gcp-controller cmd/gcp-controller/main_gen.go
# create state directory placeholder
RUN mkdir -p /threeport-state

FROM gcr.io/distroless/static:nonroot
COPY --from=builder /build/gcp-controller /
COPY --from=builder /pulumi/pulumi* /usr/local/bin/
# Copy state directory with proper ownership for nonroot user (65532:65532)
COPY --from=builder --chown=65532:65532 /threeport-state /.threeport
USER 65532:65532
ENV USER=nonroot
ENV HOME=/.threeport
ENTRYPOINT ["/gcp-controller"]
