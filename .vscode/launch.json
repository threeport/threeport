{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Connect to delve server",
            "type": "go",
            "request": "attach",
            "mode": "remote",
            "port": 40000,
            "host": "127.0.0.1",
            "showLog": true,
            "trace": "log",
            "logOutput": "rpc"
        },
        {
            "name": "Debug e2e tests",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}/test/e2e/e2e_workload_test.go",
        },
        {
            "name": "tptdev debug",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/tptdev",
            "cwd": "${workspaceFolder}",
            "args": [
                "debug",
                "--threeport-config=dev-0.yaml",
                "--component-names=workload-controller",
                "--control-plane-name=dev-0",
            ],
        },
        {
            "name": "tptdev build",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/tptdev",
            "cwd": "${workspaceFolder}",
            "args": [
                "build",
                "--all",
                "--push",
                "--arch=amd64",
                // "--control-plane-image-repo=",
                // "--control-plane-image-tag=",
            ],
        },
        {
            "name": "tptdev up",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/tptdev",
            "cwd": "${workspaceFolder}",
            "args": [
                "up",
                "--force-overwrite-config",
                // "--threeport-config=",
                // "--auth-enabled=true",
            ],
        },
        {
            "name": "tptctl create control-plane",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/tptctl",
            "args": [
                "create",
                "control-plane",
                "--provider=eks",
                "--name=test",
                "--provider-account-id=575822346426",
                "--aws-region=us-east-1",
                "--aws-config-profile=default",
            ],
        },
        {
            "name": "tptctl create control-plane oke",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/tptctl",
            "args": [
                "up",
                "--provider=oke",
                "--name=oke-test",
                "--control-plane-only",
                "-r=rj9317",
                "-t=dev-arm64",
                "--force-overwrite-config",
                "--skip-teardown",
                // "--debug",
            ],
        },
        {
            "name": "tptctl up --infra-only",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/tptctl",
            "args": [
                "up",
                "--provider=oke",
                "--name=oke-test",
                "--infra-only",
                "--skip-teardown",
                "--threeport-config=${workspaceFolder}/config.yaml",
                "--force-overwrite-config"
            ],
        },
        {
            "name": "tptctl down --infra-only",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/tptctl",
            "args": [
                "down",
                "--name=oke-test",
                "--infra-only",
            ],
        },
        {
            "name": "tptctl up oke",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/tptctl",
            "args": [
                "up",
                "--provider=oke",
                "--name=oke-test",
                "-r=rj9317",
                "-t=dev-arm64",
                "--force-overwrite-config",
                "--skip-teardown",
                "--debug",
            ],
        },
        {
            "name": "tptctl up oke --control-plane-only",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/tptctl",
            "args": [
                "up",
                "--provider=oke",
                "--name=oke-test",
                "-r=rj9317",
                "-t=dev-arm64",
                "--force-overwrite-config",
                "--skip-teardown",
                "--control-plane-only",
                "--debug",
            ],
        },
        {
            "name": "tptctl down oke",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/tptctl",
            "args": [
                "down",
                "--name=oke-test",
            ],
        },
        {
            "name": "tptctl down oke --control-plane-only",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/tptctl",
            "args": [
                "down",
                "--name=oke-test",
                "--control-plane-only",
            ],
        },
        {
            "name": "tptctl up local",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/tptctl",
            "args": [
                "up",
                "-r=localhost:5001",
                "-t=v0.7.0-dev",
                "-n=dev-0",
                "--local-registry",
                "--threeport-config=${workspaceFolder}/config.yaml",
                "--force-overwrite-config",
            ]
        }
    ]
}
